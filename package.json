{
  "name": "acmidm-login-service",
  "version": "0.13.0",
  "description": "Microservice to login using ACM/IDM with OpenId",
  "dependencies": {
    "@lblod/mu-auth-sudo": "^0.6.1",
    "openid-client": "^5.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "babel-jest": "^30.4.1",
    "express-http-context": "~1.2.4",
    "jest": "^30.4.2"
  },
  "scripts": {
    "test": "NODE_PATH=${NODE_PATH:-/usr/src/build/node_modules} PORT=0 jest --runInBand --forceExit --silent --verbose --coverage --coverageReporters=text",
    "test:bestuurseenheid": "npm test -- --runTestsByPath tests/cases/bestuurseenheid.js",
    "test:organisation": "npm test -- --runTestsByPath tests/cases/organisation.js"
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": {
            "node": "current"
          }
        }
      ]
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^mu$": "/usr/src/build/node_modules/mu/index.js"
    },
    "verbose": false,
    "testMatch": [
      "<rootDir>/tests/cases/*.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lblod/acmidm-login-service.git"
  },
  "author": "redpencil.io",
  "license": "MIT"
}
